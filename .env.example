
# Application
APP_NAME=Brightloop Subscription Management
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEBUG=true

# Database
DB_NAME=subscription_db
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:change_me@db:5432/subscription_db

# Security (generate a strong random value for SECRET_KEY)
SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
